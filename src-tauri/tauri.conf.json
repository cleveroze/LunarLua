{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LunarLua",
  "version": "1.0.0",
  "identifier": "com.lunarlua.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LunarLua",
    "copyright": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Lua/Luau obfuscator and deobfuscator",
    "longDescription": "LunarLua cleans and obfuscates Lua and Luau source code in a compact, glassy desktop app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "LunarLua"
      }
    }
  }
}
